{
  "uid": "ops-llm",
  "title": "LLM runs",
  "description": "Cost, latency and failures of the n8n workflows, from the llmobs collector.",
  "tags": ["ops", "llm"],
  "timezone": "",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs (24h)",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(increase(llm_runs_total[24h]))", "instant": true }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed runs (24h)",
      "description": "Share of runs that ended in failure. Warning above 5%, serious above 20%, which is where LlmRunsFailing pages Telegram.",
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(increase(llm_runs_total{status!=\"ok\"}[24h])) / clamp_min(sum(increase(llm_runs_total[24h])), 1)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Run duration, p95 (24h)",
      "gridPos": { "x": 10, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_run_duration_seconds_bucket[24h])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Spend (24h)",
      "description": "Priced from LLMOBS_PRICES. A model with no price is excluded and raises LlmModelNotPriced.",
      "gridPos": { "x": 15, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "instant": true, "expr": "sum(increase(llm_cost_usd_total[24h]))" }
      ]
    },
    {
      "id": 5,
      "type": "text",
      "title": "Trace a run",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": {
        "mode": "markdown",
        "content": "A panel says *a* run failed.\n\n[**llmobs**](https://llmobs.{{ base_domain }}/?status=failed) says **which node** failed, and what it cost."
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Runs per minute, by outcome",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ok" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "partial" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
                   "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{ '{{' }}status{{ '}}' }}",
          "expr": "sum by (status) (rate(llm_runs_total[5m])) * 60" }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Failures by node (7d)",
      "description": "The node each failed run died on. This is the panel that turns 'the pipeline broke' into a place to look.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "refId": "A", "instant": true,
          "legendFormat": "{{ '{{' }}failed_node{{ '}}' }} · {{ '{{' }}error_type{{ '}}' }}",
          "expr": "topk(10, sum by (failed_node, error_type) (increase(llm_run_failures_total[7d])))" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Run duration, p95 by workflow",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
                   "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{ '{{' }}workflow{{ '}}' }}",
          "expr": "histogram_quantile(0.95, sum by (le, workflow) (rate(llm_run_duration_seconds_bucket[30m])))" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Spend per hour, by model",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
                   "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{ '{{' }}model{{ '}}' }}",
          "expr": "sum by (model) (increase(llm_cost_usd_total[1h]))" }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Slowest steps, p95 (24h)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "refId": "A", "instant": true,
          "legendFormat": "{{ '{{' }}node{{ '}}' }}",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, node) (rate(llm_step_duration_seconds_bucket[24h]))))" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tokens per minute, by model and direction",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
                   "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{ '{{' }}model{{ '}}' }} {{ '{{' }}direction{{ '}}' }}",
          "expr": "sum by (model, direction) (rate(llm_tokens_total[10m])) * 60" }
      ]
    }
  ]
}
