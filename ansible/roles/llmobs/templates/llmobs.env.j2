# Managed by Ansible.
LLMOBS_DB=/data/llmobs.db
LLMOBS_PORT=9109
LLMOBS_TOKEN={{ llm_telemetry_token }}
# Run and step rows older than this are pruned. Counters are kept forever, so
# pruning never makes a Prometheus rate() go backwards.
LLMOBS_RETENTION_DAYS={{ llmobs_retention_days }}
LLMOBS_MAX_SERIES={{ llmobs_max_series }}
# USD per million tokens. A model missing here is counted but not priced, and
# raises llmobs_unknown_model_total so the spend panel can't quietly read zero.
LLMOBS_PRICES={{ llmobs_prices | to_json }}
