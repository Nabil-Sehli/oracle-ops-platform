# Managed by Ansible.
# Candles come from Twelve Data's free plan (twelvedata.com, 800 requests a
# day). OANDA's own feed would match the TradingView chart exactly, but its EU
# demo accounts are MT5-only, with no API.
TWELVEDATA_KEY={{ goldcrt_twelvedata_key }}
TELEGRAM_TOKEN={{ telegram_bot_token }}
TELEGRAM_CHAT_IDS={{ goldcrt_chat_ids | join(',') }}
# Dead man's switch: Kuma alerts when no hourly check arrives for 3 hours.
KUMA_PUSH_URL=http://uptime-kuma:3001/api/push/{{ kuma_gold_push_token }}
TZ_DISPLAY={{ timezone }}
# Candles replayed on every check. Key levels live up to 500 bars, so this
# leaves a long warm-up and the result matches the indicator's full history.
HISTORY_BARS=3000
STATE_FILE=/data/state.json
