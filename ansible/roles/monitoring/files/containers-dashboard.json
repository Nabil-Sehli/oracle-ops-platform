{
  "uid": "ops-containers",
  "title": "Containers",
  "description": "Per-container resource use from cAdvisor.",
  "tags": ["ops", "docker"],
  "timezone": "",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Running containers",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(container_last_seen{name=~\"ops-.+\"})" }]
    },
    {
      "id": 2, "type": "stat", "title": "Memory used by containers",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(container_memory_working_set_bytes{name=~\"ops-.+\"})" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "CPU (cores)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{
        "refId": "A", "legendFormat": "{{name}}",
        "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"ops-.+\"}[$__rate_interval]))"
      }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Memory (working set)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{
        "refId": "A", "legendFormat": "{{name}}",
        "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"ops-.+\"})"
      }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Network received",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [{
        "refId": "A", "legendFormat": "{{name}}",
        "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"ops-.+\"}[$__rate_interval]))"
      }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Network sent",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [{
        "refId": "A", "legendFormat": "{{name}}",
        "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"ops-.+\"}[$__rate_interval]))"
      }]
    }
  ]
}
