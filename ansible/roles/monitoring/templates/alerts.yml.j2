# Managed by Ansible. Alerts go to Telegram through Alertmanager.
# Website uptime is Uptime Kuma's job; these cover the server itself.
groups:
  - name: host
    rules:
      - alert: DiskAlmostFull
        expr: 1 - node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"} > 0.80
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "Disk / is {{ '{{' }} $value | humanizePercentage {{ '}}' }} full on {{ '{{' }} $labels.instance {{ '}}' }}"

      - alert: DiskFillingUp
        expr: predict_linear(node_filesystem_avail_bytes{mountpoint="/"}[6h], 24 * 3600) < 0
        for: 1h
        labels: { severity: warning }
        annotations:
          summary: "Disk / on {{ '{{' }} $labels.instance {{ '}}' }} will be full within 24 hours at the current rate"

      - alert: MemoryHigh
        expr: 1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes > 0.90
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "Memory use is {{ '{{' }} $value | humanizePercentage {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }}"

      - alert: OutOfMemoryKill
        expr: increase(node_vmstat_oom_kill[15m]) > 0
        labels: { severity: critical }
        annotations:
          summary: "The kernel killed a process for lack of memory on {{ '{{' }} $labels.instance {{ '}}' }}"

      - alert: CpuBusy
        expr: avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) < 0.10
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "CPU has been over 90% busy for 15 minutes on {{ '{{' }} $labels.instance {{ '}}' }}"

  - name: containers
    rules:
{% for name in monitored_containers %}
      - alert: ContainerMissing
        expr: absent_over_time(container_last_seen{name="ops-{{ name }}-1"}[2m])
        for: 3m
        labels: { severity: critical, container: {{ name }} }
        annotations:
          summary: "Container {{ name }} is not running"
{% endfor %}

  # The workflows report their own runs to llmobs. These alerts are about the
  # pipeline being wrong, not about the box being unhealthy.
  - name: llm
    rules:
      - alert: LlmRunsFailing
        expr: |
          sum by (workflow) (rate(llm_runs_total{status!="ok"}[15m]))
            / sum by (workflow) (rate(llm_runs_total[15m])) > 0.2
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "{{ '{{' }} $value | humanizePercentage {{ '}}' }} of {{ '{{' }} $labels.workflow {{ '}}' }} runs are failing"

      - alert: LlmProviderErrors
        expr: increase(llm_provider_responses_total{code=~"429|5.."}[15m]) > 3
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "{{ '{{' }} $labels.model {{ '}}' }} answered {{ '{{' }} $labels.code {{ '}}' }} {{ '{{' }} $value {{ '}}' }} times in 15 minutes"

      - alert: LlmRunsSlow
        expr: |
          histogram_quantile(0.95,
            sum by (le, workflow) (rate(llm_run_duration_seconds_bucket[30m]))) > {{ llm_slow_run_seconds }}
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "95th percentile of {{ '{{' }} $labels.workflow {{ '}}' }} is {{ '{{' }} $value | humanizeDuration {{ '}}' }}"

      - alert: LlmSpendOverBudget
        expr: sum(increase(llm_cost_usd_total[24h])) > {{ llm_daily_budget_usd }}
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "LLM spend in the last 24h is ${{ '{{' }} $value | printf \"%.2f\" {{ '}}' }}, over the ${{ llm_daily_budget_usd }} budget"

      # Without a price the cost panels read zero, which looks like "free"
      # rather than "unknown". Add the model to llmobs_prices in site.yml.
      - alert: LlmModelNotPriced
        expr: increase(llmobs_unknown_model_total[6h]) > 0
        labels: { severity: warning }
        annotations:
          summary: "No price for model {{ '{{' }} $labels.model {{ '}}' }}; its spend is missing from the totals"

  - name: monitoring
    rules:
      - alert: ScrapeTargetDown
        expr: up == 0
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "Prometheus can't scrape {{ '{{' }} $labels.job {{ '}}' }} ({{ '{{' }} $labels.instance {{ '}}' }})"
