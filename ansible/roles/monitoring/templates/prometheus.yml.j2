# Managed by Ansible.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: [alertmanager:9093]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: [localhost:9090]

  - job_name: alertmanager
    static_configs:
      - targets: [alertmanager:9093]

  # node_exporter runs in the host network namespace (real NIC stats) and listens
  # only on the docker0 bridge address, never on the public interface.
  - job_name: node
    static_configs:
      - targets: ["{{ node_exporter_listen }}"]
        labels:
          instance: {{ inventory_hostname }}

  - job_name: cadvisor
    static_configs:
      - targets: [cadvisor:8080]
        labels:
          instance: {{ inventory_hostname }}

  # Per-run LLM cost, latency and failures, posted by the workflows themselves.
  - job_name: llmobs
    static_configs:
      - targets: [llmobs:9109]
        labels:
          instance: {{ inventory_hostname }}

  # n8n's own counters (executions started, succeeded, failed). They say a run
  # failed; llmobs says which node failed and what it cost.
  - job_name: n8n
    static_configs:
      - targets: [n8n:5678]
        labels:
          instance: {{ inventory_hostname }}
