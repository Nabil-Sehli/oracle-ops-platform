# Managed by Ansible. Read by all four Jitsi containers.
TZ={{ timezone }}
PUBLIC_URL=https://{{ jitsi_domain }}

# Caddy terminates TLS and proxies plain HTTP to jitsi-web:8000.
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0

# Oracle maps the public IP to the instance with 1:1 NAT, so the VM only knows
# its private address. The bridge has to be told which address to hand out,
# or clients try to send media to 10.x and the call connects with no video.
JVB_ADVERTISE_IPS={{ public_ip }}
JVB_PORT=10000

# Internal XMPP accounts for the focus and the bridge.
JICOFO_AUTH_PASSWORD={{ jitsi_jicofo_password }}
JVB_AUTH_PASSWORD={{ jitsi_jvb_password }}

# Only members logged in to the school app can join: the app signs a
# short-lived token for one room, and anyone without one is turned away.
# No guest or lobby fallback.
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
JWT_APP_ID={{ jitsi_jwt_app_id }}
JWT_APP_SECRET={{ jitsi_jwt_secret }}
JWT_ACCEPTED_ISSUERS={{ jitsi_jwt_app_id }}
JWT_ACCEPTED_AUDIENCES=jitsi

# Teachers become moderators through a claim in their token
# (context.user.moderator); everyone else joins as a member. Auto-owner is off,
# or whoever joins first becomes moderator: a student, if they are early.
XMPP_MUC_MODULES=token_affiliation
ENABLE_AUTO_OWNER=false
# Jicofo's own authentication defaults to ENABLE_AUTH, and in JWT mode it makes
# every occupant who logged in with a token an owner, overruling
# token_affiliation: students could end the meeting for everyone. Prosody still
# refuses anyone without a valid token; only jicofo's role grant is switched off.
JICOFO_ENABLE_AUTH=0

# Pupils' browsers talk only to this server (no Gravatar, no external fonts or
# stats), and only the school site may embed a call.
ENABLE_THIRD_PARTY_REQUESTS=false
CSP_HEADER=frame-ancestors {{ jitsi_embed_origins | join(' ') }}

# Java heaps default to 3 GB each, sized for a dedicated box. This one is shared.
JICOFO_MAX_MEMORY={{ jitsi_jicofo_max_memory }}
VIDEOBRIDGE_MAX_MEMORY={{ jitsi_jvb_max_memory }}
